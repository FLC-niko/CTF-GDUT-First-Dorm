# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.masterjie.eu.cc/v1
GEMINI_API_KEY=

# OpenAI-compatible gateway (Pydantic / azure provider path)
AZURE_OPENAI_ENDPOINT=https://api.masterjie.eu.cc/v1
AZURE_OPENAI_API_KEY=sk-...

# Explicit protocol routes. CPA URLs depend on your deployment.
# Model IDs stay in --models; protocol is selected by the provider alias.
CPA_RESPONSES_BASE_URL=
CPA_CHAT_BASE_URL=
CPA_API_KEY=
# OpenCode Go defaults are built in. The Messages client base intentionally omits
# /v1 because the Anthropic SDK appends /v1/messages.
OPENCODE_GO_CHAT_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MESSAGES_BASE_URL=https://opencode.ai/zen/go
OPENCODE_GO_RESPONSES_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=
# Optional live smoke selectors (still require RUN_PROVIDER_LIVE=1 on the command)
CPA_SMOKE_MODEL=
GO_SMOKE_MODEL=

# Local provider governance (0 token budget means disabled)
CPA_MAX_CONCURRENCY=2
CPA_SOFT_TOKEN_BUDGET=0
CPA_HARD_TOKEN_BUDGET=0
OPENCODE_GO_MAX_CONCURRENCY=2
OPENCODE_GO_SOFT_TOKEN_BUDGET=0
OPENCODE_GO_HARD_TOKEN_BUDGET=0
PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=60
# Keep false unless you explicitly accept metered API charges.
ALLOW_PAID_API_FALLBACK=false

# Sandbox/worker governance. A worker file may describe local, Intel Mac,
# Apple Silicon, Windows Docker Desktop, and SSH Linux workers without storing
# passwords or tokens. Use SSH config/agent or an external identity file.
WORKER_CONFIG_FILE=
LOCAL_WORKER_ARCH=
SANDBOX_IMAGE=ctf-sandbox
MAX_CONCURRENT_CONTAINERS=2
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPU_LIMIT=2
CONTAINER_PIDS_LIMIT=512
SANDBOX_SECURITY_PROFILE=auto
SANDBOX_NETWORK_MODE=bridge
SANDBOX_LOOP_DEVICE=

# Lingxu Event CTF (optional)
# Cookie must contain sessionid. If csrftoken exists in your browser, you can keep it too.
PLATFORM=
PLATFORM_URL=
LINGXU_EVENT_ID=
LINGXU_COOKIE=
